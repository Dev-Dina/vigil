# Demo secrets template (Gate DEMO-RUNBOOK).
#
# Copy this file to ".env.demo" (which is GITIGNORED) and fill in the real values.
# demo-up.ps1 reads .env.demo and sets these as $env: for the session — NEVER hardcode secrets,
# NEVER commit .env.demo. These are the same three the live stack needs (docker-compose.live.yml).
#
#   cp .env.demo.example .env.demo   # then edit .env.demo with the real values

# Scoped READ-ONLY token for the PERSISTENT Vault (NOT the root token). Minted once against the
# persistent Vault with the vigil-app-ro policy (see docs/RUNBOOK.md §1.B). ~95 chars.
VAULT_TOKEN=

# The Guide's OWN Anthropic key (sk-ant-...). Distinct from the app's key; read only by the Guide,
# which has no Vault client (docker-compose.live.yml:79).
VIGIL_GUIDE_LLM_API_KEY=

# Langfuse host for live tracing. Default is the cloud host; override for a region/self-hosted host.
VIGIL_LANGFUSE_HOST=https://cloud.langfuse.com
