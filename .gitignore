.env
data/raw
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/

# Golden-set clean scratch (the committed oracle is tests/golden/{raw,expected}).
tests/golden/_clean_tmp/
.vscode/

# Vault dev persistence — NEVER commit data or unseal material (unseal keys / root token).
# The compose data volume is a named Docker volume (outside the repo); these cover any local
# bind-mounted data dir or init-output file a developer might create.
infra/vault/data/
infra/vault/*.local
infra/vault/init.json

# Guide-owned build artifacts (the approved-doc index is built by guide/build_index.py)
guide/data/
tests/guide/_built_index.json
