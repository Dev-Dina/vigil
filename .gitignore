.env
# Demo secrets (Gate DEMO-RUNBOOK) — VAULT_TOKEN / Guide key / Langfuse host for demo-up.ps1.
# NEVER committed; the committed .env.demo.example documents the variable NAMES only.
.env.demo
data/raw
__pycache__/
*.pyc

# Throwaway local key/connectivity probes — never commit (read secrets from Vault/env at runtime).
_keytest*
.venv/
.ruff_cache/
.pytest_cache/

# Golden-set clean scratch (the committed oracle is tests/golden/{raw,expected}).
tests/golden/_clean_tmp/
.vscode/

# Vault dev persistence — NEVER commit data or unseal material (unseal keys / root token).
# The compose data volume is a named Docker volume (outside the repo); these cover any local
# bind-mounted data dir or init-output file a developer might create.
infra/vault/data/
infra/vault/*.local
infra/vault/init.json

# Guide-owned build artifacts (the approved-doc index is built by guide/build_index.py)
guide/data/
tests/guide/_built_index.json

# Guide layer-3 proof run artifact (transcript from run-isolation-proof)
deploy/k8s/last-proof-transcript.txt

# Frontend TypeScript incremental build cache — a regenerable build artifact, never committed.
*.tsbuildinfo

# marimo editor session cache (generated; embeds local absolute paths) — never committed.
__marimo__/
